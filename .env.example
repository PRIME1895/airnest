# GEMINI_API_KEY: Required for server-side Gemini AI API calls (never exposed to browser).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Provisioned by AI Studio for Google Maps Platform JS SDK.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# GOOGLE_MAPS_API_KEY: Optional server-side key for Google Maps Air Quality API adapter.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: Public URL where AirNest is hosted.
APP_URL="http://localhost:3000"

# PORT: HTTP server port (AI Studio requires 3000 in dev).
PORT="3000"

# ALLOWED_ORIGINS: Comma-separated CORS allowlist (optional; defaults to localhost + APP_URL).
ALLOWED_ORIGINS="http://localhost:3000"
